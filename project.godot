; PUW prototype: REAL GODOT 4 3D/Sprite3D hybrid, not the retired browser grid prototype.
config_version=5

[application]
config/name="Pokémon Ultimate World - Neon Recovery Branch v0.3.0 (Playable Slice)"
run/main_scene="res://scenes/boot/boot_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Cheats="*res://systems/cheats/cheat_engine.gd"
Mods="*res://systems/mods/mod_loader.gd"
BattleAnims="*res://battle/presentation/battle_anim.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"


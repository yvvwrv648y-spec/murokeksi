{
  "version": "2026-11-22",
  "chroma_key": "#FF00FF",
  "custom_creation_preservation_contract": {
    "rule": "NEVER override Custom Protagonist player-chosen appearance, gender presentation, hair/skin/eye palette swaps, or height/build sliders with baked placeholders on bicycles or rideable Pokemon.",
    "pipeline": "Composite riderless bike chassis (or Pokemon sprite) + Custom Base Body (with runtime shader palette-swap + uniform height/build scale) + equipped Outfit-Only Layer.",
    "animation_tiers": {
      "riley": "unique_signature (Acro wheelies, rail-balance, waving tandem stoker, playful hands-on-hips hover)",
      "tasha": "unique_signature (Mach aero-tuck, brake drift, hand-on-hip tandem stoker, iconic arms-folded Metagross hover)",
      "custom_female": "generic_custom_layered (standard cycling & 13-mode mount poses; 100% slider & palette-swap safe)",
      "custom_male": "generic_custom_layered (standard cycling & 13-mode mount poses; 100% slider & palette-swap safe)",
      "custom_femboy": "generic_custom_layered (standard cycling & 13-mode mount poses; 100% slider & palette-swap safe)",
      "custom_futanari": "generic_custom_layered (standard cycling & 13-mode mount poses; 100% slider & palette-swap safe)"
    }
  },
  "compositing_z_order": {
    "solo_bike": [
      "bike_chassis_layer",
      "rider_base_body (palette-swapped + scaled)",
      "rider_outfit_layer"
    ],
    "tandem_bike": [
      "bike_chassis_tandem",
      "rear_passenger_base_body",
      "rear_passenger_outfit",
      "front_driver_base_body",
      "front_driver_outfit"
    ],
    "pokemon_ride": [
      "pokemon_mount_sprite",
      "rider_base_body (palette-swapped + scaled)",
      "rider_outfit_layer"
    ]
  },

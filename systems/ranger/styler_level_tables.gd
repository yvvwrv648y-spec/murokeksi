static func table_for(region_id: String, track: String = "present") -> Array:
	if region_id == "fiore":
		return FIORE
	if region_id == "almia":
		return ALMIA
	if region_id == "oblivia":
		if track == "past":
			return OBLIVIA_PAST
		return OBLIVIA_PRESENT
	return []


static func row_for(region_id: String, level: int, track: String = "present") -> Dictionary:
	var table: Array = table_for(region_id, track)
	if table.is_empty():
		return {}
	var clamped: int = clampi(level, 1, table.size())
	var value: Variant = table[clamped - 1]
	if value is Dictionary:
		var row: Dictionary = value
		return row
	return {}

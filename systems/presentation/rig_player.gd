class_name PUWRigPlayer
extends RefCounted
## PUW in-house engine rigging — the motion sampler (route 3 of
## the animation-completion sourcing plan; see RIGGING.md).
##
## A rig definition (data/rig_definitions.json, generated by
## tools/build_rigging.py from the species' real PokeAPI shape,
## follower domains, types, abilities, height and weight) names
## sprite PARTS (normalized regions of the indexed still) and
## motion TRACKS (idle + movement) with per-part parameters
## (kind, freq_hz, amp, phase_deg). This player turns a
## definition + a track name + a time into per-part transforms:
##
##   { part_name: {"offset": Vector2 (fractions of sprite size),
##                 "rotation_deg": float,
##                 "scale": Vector2} }
##
## The motion is REAL by construction: every track kind is a
## time function, so sampled poses at different times differ
## per part (proven by tests/rigging_tests.gd). PUWRigStage
## applies these transforms to region sprites cut from the
## streamed still; nothing here draws or invents art — the
## source picture is the indexed PokeAPI still, and the result
## is labeled "engine-rigged" everywhere it surfaces.
##
## Track kinds:
##   none        identity
##   bob_y       vertical bob, offset.y = amp * sin(phase)
##   hop_y       hop, offset.y = -amp * |sin(phase)|
##   undulate_x  lateral wave, offset.x = amp * sin(phase)
##               (per-segment phase offsets make the wave travel)
##   breath      breathing scale pulse
##   rot_sway    rotation sway, rotation = amp * sin(phase) (deg)
##   flap        wing flap: rotation = amp * sin(phase) (deg),
##               larger amplitudes than rot_sway by template
##   stride      limb stride: offset.y = -amp * |sin(phase)|
##               with a small forward/back offset.x swing
##   roll        continuous roll, rotation = 360 * freq * t

const TRACK_IDLE: String = "idle"
const TRACK_MOVEMENT: String = "movement"


## Sample every part of a definition on one track at time t
## (seconds). Parts with no entry on the track hold identity.
static func sample(definition: Dictionary, track_name: String, t: float) -> Dictionary:
	var out: Dictionary = {}
	var parts_value: Variant = definition.get("parts", {})
	if not (parts_value is Dictionary):
		return out
	var parts: Dictionary = parts_value
	var tracks_value: Variant = definition.get("tracks", {})
	var track: Dictionary = {}
	if tracks_value is Dictionary:
		var tracks: Dictionary = tracks_value
		var track_value: Variant = tracks.get(track_name, {})
		if track_value is Dictionary:
			track = track_value
	if track.is_empty():
		# Class templates carry their tracks at the top level
		# ({"parts": ..., "idle": ..., "movement": ...}) with no
		# "tracks" wrapper; read that schema too.
		var top_value: Variant = definition.get(track_name, {})
		if top_value is Dictionary:
			var top_track: Dictionary = top_value
			track = top_track
	for part_name_value in parts:
		var part_name: String = str(part_name_value)
		var entry: Dictionary = {}
		var entry_value: Variant = track.get(part_name, {})
		if entry_value is Dictionary:
			entry = entry_value
		out[part_name] = sample_part(entry, t)
	return out


## Sample one part's track entry at time t.
static func sample_part(entry: Dictionary, t: float) -> Dictionary:
	var kind: String = str(entry.get("kind", "none"))
	var freq: float = float(entry.get("freq_hz", 0.0))
	var amp: float = float(entry.get("amp", 0.0))
	var phase_deg: float = float(entry.get("phase_deg", 0.0))
	var offset: Vector2 = Vector2.ZERO
	var rotation_deg: float = 0.0
	var scale: Vector2 = Vector2.ONE
	if kind == "none" or (amp == 0.0 and kind != "roll"):
		return {"offset": offset, "rotation_deg": rotation_deg, "scale": scale}
	var phase: float = TAU * freq * t + deg_to_rad(phase_deg)
	var s: float = sin(phase)
	match kind:
		"bob_y":
			offset.y = amp * s
		"hop_y", "stride":
			offset.y = -amp * abs(s)
			if kind == "stride":
				offset.x = 0.35 * amp * cos(phase)
		"undulate_x", "sway_x":
			offset.x = amp * s
		"breath":
			scale = Vector2(1.0 + 0.4 * amp * s, 1.0 + amp * s)
		"rot_sway", "flap":
			rotation_deg = amp * s
		"roll":
			rotation_deg = fmod(360.0 * freq * t + phase_deg, 360.0)
	return {"offset": offset, "rotation_deg": rotation_deg, "scale": scale}


## The largest absolute difference between two samples of the
## same definition/track (offset in fractions, rotation in
## degrees, scale unitless) — the motion-reality measure the
## test suite asserts on.
static func sample_distance(a: Dictionary, b: Dictionary) -> float:
	var best: float = 0.0
	for part_name_value in a:
		var part_name: String = str(part_name_value)
		if not b.has(part_name):
			continue
		var pa: Dictionary = a[part_name]
		var pb: Dictionary = b[part_name]
		var oa: Vector2 = pa.get("offset", Vector2.ZERO)
		var ob: Vector2 = pb.get("offset", Vector2.ZERO)
		best = maxf(best, oa.distance_to(ob))
		best = maxf(best, absf(float(pa.get("rotation_deg", 0.0)) - float(pb.get("rotation_deg", 0.0))) / 180.0)
		var sa: Vector2 = pa.get("scale", Vector2.ONE)
		var sb: Vector2 = pb.get("scale", Vector2.ONE)
		best = maxf(best, sa.distance_to(sb))
	return best

class_name PUWRigRegistry
extends RefCounted
## PUW engine-rigging registry: loads the generated rig
## definitions + escalation list and answers the questions the
## resolvers and tests ask:
##
##   follower_rig(showdown_id) / battle_rig(showdown_id)
##       -> the rig definition Dictionary, or {} when the
##          species has none.
##   escalation_for(showdown_id, context)
##       -> the escalation entry, or {} when not escalated.
##   animation_status(context, showdown_id, base_classification)
##       -> exactly one of "source-animated", "engine-rigged",
##          "neon-gap" (the universe trichotomy the rigging
##          suite asserts across all 1,025 base + 397 forms +
##          1,519 MDX slots, per context).
##
## Data: res://data/rig_definitions.json and
## res://data/rig_escalations.json, both generated by
## tools/build_rigging.py from real species data (PokeAPI
## shape/domains/types/abilities/size). Provenance is honest:
## a rigged species' art is its indexed still, animated by the
## engine — never passed off as source-animated.

const DEFINITIONS_PATH: String = "res://data/rig_definitions.json"
const ESCALATIONS_PATH: String = "res://data/rig_escalations.json"

const STATUS_SOURCE_ANIMATED: String = "source-animated"
const STATUS_ENGINE_RIGGED: String = "engine-rigged"
const STATUS_NEON_GAP: String = "neon-gap"

static var _shared: Dictionary = {}

var _follower: Dictionary = {}
var _battle: Dictionary = {}
var _templates: Dictionary = {}
var _escalations: Array = []
var _loaded: bool = false


func _init() -> void:
	load_data()


func load_data() -> bool:
	_loaded = true
	if _shared.has("rig_data"):
		var cached: Dictionary = _shared["rig_data"]
		_follower = cached.get("follower", {})
		_battle = cached.get("battle", {})
		_templates = cached.get("templates", {})
		_escalations = cached.get("escalations", [])
		return true
	var defs: Dictionary = _read_json(DEFINITIONS_PATH)
	var esc: Dictionary = _read_json(ESCALATIONS_PATH)
	if defs.is_empty():
		return false
	var follower_value: Variant = defs.get("follower", {})
	if follower_value is Dictionary:
		_follower = follower_value
	var battle_value: Variant = defs.get("battle", {})
	if battle_value is Dictionary:
		_battle = battle_value
	var templates_value: Variant = defs.get("templates", {})
	if templates_value is Dictionary:
		_templates = templates_value
	var esc_value: Variant = esc.get("escalations", [])
	if esc_value is Array:
		_escalations = esc_value
	_shared["rig_data"] = {"follower": _follower, "battle": _battle, "templates": _templates, "escalations": _escalations}
	return true


## The body-plan template definition (parts + idle/movement
## tracks) for a locomotion class — "quadruped",
## "hover_levitator", ... — or {} when the class is unknown.
## Binding build 5 (2026-11-24): the presentation layer
## resolves a rig RECORD to its template through here; before
## this, templates were only ever read by the offline contact
## sheet tool.
func template_definition(locomotion_class: String) -> Dictionary:
	var value: Variant = _templates.get(locomotion_class.strip_edges().to_lower(), {})
	if value is Dictionary:
		var definition: Dictionary = value
		return definition
	return {}


## The playable rig definition for a rig record (the
## dictionaries follower_rig / battle_rig return): the
## template named by the record's locomotion class. {} when
## the record names no known template.
func definition_for_rig(rig: Dictionary) -> Dictionary:
	if rig.is_empty():
		return {}
	var direct_value: Variant = rig.get("definition", {})
	if direct_value is Dictionary:
		var direct: Dictionary = direct_value
		if not direct.is_empty():
			return direct
	# The record itself is the playable definition: build_rigging.py
	# records carry the species' own parts plus a tracks dict in
	# PUWRigPlayer's schema. (Build-5 fix: this accessor previously
	# returned the class TEMPLATE, whose tracks sit at the top
	# level where the player never looked — every rig sampled as a
	# static pose.) The template is only a fallback for a record
	# that carries no tracks of its own.
	var tracks_value: Variant = rig.get("tracks", {})
	if tracks_value is Dictionary:
		var tracks: Dictionary = tracks_value
		if not tracks.is_empty() and rig.has("parts"):
			return rig
	return template_definition(str(rig.get("locomotion_class", "")))


func is_loaded() -> bool:
	return not _follower.is_empty()


func follower_rig(showdown_id: String) -> Dictionary:
	var rig_value: Variant = _follower.get(showdown_id.strip_edges().to_lower(), {})
	if rig_value is Dictionary:
		var rig: Dictionary = rig_value
		return rig
	return {}


func battle_rig(showdown_id: String) -> Dictionary:
	var rig_value: Variant = _battle.get(showdown_id.strip_edges().to_lower(), {})
	if rig_value is Dictionary:
		var rig: Dictionary = rig_value
		return rig
	return {}


func has_follower_rig(showdown_id: String) -> bool:
	return not follower_rig(showdown_id).is_empty()


func has_battle_rig(showdown_id: String) -> bool:
	return not battle_rig(showdown_id).is_empty()


func escalation_for(showdown_id: String, context: String) -> Dictionary:
	var sid: String = showdown_id.strip_edges().to_lower()
	for entry_value in _escalations:
		if not (entry_value is Dictionary):
			continue
		var entry: Dictionary = entry_value
		if str(entry.get("showdown_id", "")) == sid and str(entry.get("context", "")) == context:
			return entry
	return {}


func is_escalated(showdown_id: String, context: String) -> bool:
	return not escalation_for(showdown_id, context).is_empty()


func follower_rig_count() -> int:
	return _follower.size()


func battle_rig_count() -> int:
	return _battle.size()


func escalation_count() -> int:
	return _escalations.size()


func follower_rig_ids() -> Array:
	var ids: Array = _follower.keys()
	ids.sort()
	return ids


func battle_rig_ids() -> Array:
	var ids: Array = _battle.keys()
	ids.sort()
	return ids


func escalations() -> Array:
	return _escalations.duplicate()


## Rigged-per-class counts for one context ("follower"/"battle").
func rig_counts_by_class(context: String) -> Dictionary:
	var source: Dictionary = _follower if context == "follower" else _battle
	var counts: Dictionary = {}
	for sid_value in source:
		var rig_value: Variant = source[sid_value]
		if rig_value is Dictionary:
			var rig: Dictionary = rig_value
			var cls: String = str(rig.get("locomotion_class", ""))
			counts[cls] = int(counts.get(cls, 0)) + 1
	return counts


## The universe trichotomy: given the base resolver
## classification for a species in a context ("animated",
## "static-only" or "missing"), return exactly one animation
## status. Source-animated wins; a rig definition makes it
## engine-rigged; anything else is on the Neon gap list.
func animation_status(context: String, showdown_id: String, base_classification: String, family: String = "PKDX") -> String:
	if family == "MDX":
		return STATUS_NEON_GAP
	if base_classification == "animated":
		return STATUS_SOURCE_ANIMATED
	if context == "follower" and has_follower_rig(showdown_id):
		return STATUS_ENGINE_RIGGED
	if context == "battle" and has_battle_rig(showdown_id):
		return STATUS_ENGINE_RIGGED
	return STATUS_NEON_GAP


static func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var text: String = FileAccess.get_file_as_string(path)
	if text.is_empty():
		return {}
	var parsed_value: Variant = JSON.parse_string(text)
	if parsed_value is Dictionary:
		var parsed: Dictionary = parsed_value
		return parsed
	return {}

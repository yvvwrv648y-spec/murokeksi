extends SceneTree
## Dialogue choice-split tests — TERMINATOR prep upgrade
## (hidden_files/code_prep_dialogue_terminator).
##
## This is the choices prep's suite with the NO-path assertions
## upgraded to the v2 runner semantics: PUWChoiceAssembler now
## emits one branch_end marker per choice block (between the NO
## and YES sections, goto = first tail line or block end) and
## PUWDialogueRunner resolves markers on landing. Expectations
## come from work/expected_playback.json regenerated by this
## prep's independent Python replication (tools/
## replicate_playback_v2.py), which cross-checked every text,
## branch list, YES playback and source NO sequence against the
## choices prep's v1 fixture — identical — and simulated the v2
## assembly + runner to prove both paths exact.
##
## Playback properties proven here:
##   - every split entry assembles to exactly the bridge's lines
##     plus its declared restored lines (multiset over playable
##     entries; branch_end markers carry no text), in the layout
##     order the replication predicts (exact sequence);
##   - each choice block's structure matches the replication:
##     prompt, NO lines, exactly one branch_end marker with the
##     expected goto, YES lines, tail lines; the prompt's choice
##     targets match the replication's block-relative targets;
##   - the YES path of all 30 choice points plays the exact
##     source line sequence (prompt + yes branch + shared tail);
##   - the NO path of all 30 choice points plays the exact
##     source line sequence (prompt + no branch + shared tail)
##     — upgraded from the v1 suite, which could only assert
##     exactness at the 6 runner-expressible points and the
##     NO-prefix + fall-through replication at the other 24.
##
## Run: godot --headless --path test_project \
##        --script res://tests/choice_tests.gd

var _passed: int = 0
var _failed: int = 0
var _failed_names: Array = []

var _assembler: RefCounted = null
var _runner_script: GDScript = null
var _expected: Dictionary = {}
var _keys: Array = []


func _init() -> void:
	print("PUW dialogue choice tests (terminator v2) — starting.")
	var assembler_script: GDScript = load(
		"res://systems/dialogue/choice_assembler.gd")
	_assembler = assembler_script.new()
	_runner_script = load("res://systems/dialogue/dialogue_runner.gd")
	var exp_v: Variant = _load_json("res://data/expected_playback.json")
	if exp_v is Dictionary:
		var exp: Dictionary = exp_v
		var entries_v: Variant = exp.get("entries", {})
		if entries_v is Dictionary:
			_expected = entries_v
	_keys = _expected.keys()
	_keys.sort()

	_run("test_delta_covers_28_roots", Callable(self, "test_delta_covers_28_roots"))
	_run("test_partition_and_layout", Callable(self, "test_partition_and_layout"))
	_run("test_block_structure", Callable(self, "test_block_structure"))
	_run("test_yes_paths_exact", Callable(self, "test_yes_paths_exact"))
	_run("test_no_paths", Callable(self, "test_no_paths"))
	_run("test_no_split_fallback", Callable(self, "test_no_split_fallback"))
	_run("test_choice_block_descriptors", Callable(self, "test_choice_block_descriptors"))
	_run("test_bill_box_renders_choices", Callable(self, "test_bill_box_renders_choices"))

	print("SUMMARY: %d passed, %d failed." % [_passed, _failed])
	if _failed > 0:
		print("FAILED: ", _failed_names)
	quit(1 if _failed > 0 else 0)


# ----------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------

func _run(name: String, fn: Callable) -> void:
	var before: int = _failed
	fn.call()
	if _failed == before:
		_passed += 1
		print("PASS ", name)
	else:
		_failed_names.append(name)
		print("FAIL ", name)


func _check(cond: bool, what: String) -> void:
	if not cond:
		_failed += 1
		print("  check failed: ", what)


static func _load_json(path: String) -> Variant:
	var f: FileAccess = FileAccess.open(path, FileAccess.READ)
	if f == null:
		return null
	var text: String = f.get_as_text()
	f.close()
	return JSON.parse_string(text)


func _split_key(key: String) -> Array:
	var parts: PackedStringArray = key.split("|")
	return [String(parts[0]), String(parts[1])]


static func _is_branch_end(line_v: Variant) -> bool:
	if line_v is Dictionary:
		var d: Dictionary = line_v
		return bool(d.get("branch_end", false))
	return false


static func _texts_of(lines: Array) -> Array:
	var out: Array = []
	for line_v in lines:
		if line_v is Dictionary:
			var d: Dictionary = line_v
			out.append(String(d.get("text", "")))
		else:
			out.append(String(line_v))
	return out


## Texts of the playable entries only: branch_end markers are
## runner control entries, not dialogue lines.
static func _playable_texts_of(lines: Array) -> Array:
	var out: Array = []
	for line_v in lines:
		if _is_branch_end(line_v):
			continue
		if line_v is Dictionary:
			var d: Dictionary = line_v
			out.append(String(d.get("text", "")))
		else:
			out.append(String(line_v))
	return out


static func _sorted_copy(a: Array) -> Array:
	var out: Array = a.duplicate()
	out.sort()
	return out


## Play one choice block on the real runner, choosing choice_idx
## at the prompt; returns every line played, prompt first.
func _play_block(block: Array, choice_idx: int) -> Array:
	var runner: RefCounted = _runner_script.new()
	runner.setup(block)
	var played: Array = []
	if runner.is_finished():
		return played
	played.append(runner.current_text())
	runner.choose(choice_idx)
	while not runner.is_finished():
		played.append(runner.current_text())
		runner.advance()
	return played


func _entry(key: String) -> Dictionary:
	var e_v: Variant = _expected.get(key, {})
	if e_v is Dictionary:
		var e: Dictionary = e_v
		return e
	return {}


func _choices_of(key: String) -> Array:
	var e: Dictionary = _entry(key)
	var c_v: Variant = e.get("choices", [])
	if c_v is Array:
		var c: Array = c_v
		return c
	return []


# ----------------------------------------------------------------
# Tests
# ----------------------------------------------------------------

func test_delta_covers_28_roots() -> void:
	_check(_keys.size() == 28, "fixture holds 28 split entries, got %d"
		% _keys.size())
	var split_count: int = 0
	for key_v in _keys:
		var key: String = key_v
		var parts: Array = _split_key(key)
		if _assembler.has_split(parts[0], parts[1]):
			split_count += 1
	_check(split_count == 28, "assembler finds all 28 splits, got %d"
		% split_count)
	var total_choices: int = 0
	for key_v in _keys:
		total_choices += _choices_of(String(key_v)).size()
	_check(total_choices == 30, "30 choice points across the 28 roots, got %d"
		% total_choices)


func test_partition_and_layout() -> void:
	for key_v in _keys:
		var key: String = key_v
		var parts: Array = _split_key(key)
		var e: Dictionary = _entry(key)
		var assembled: Array = _assembler.assemble(parts[0], parts[1])
		var texts: Array = _playable_texts_of(assembled)
		var want_layout_v: Variant = e.get("assembled_texts", [])
		_check(texts == want_layout_v,
			"%s assembled layout (playable entries) matches the independent replication" % key)
		var want_set: Array = []
		var bt_v: Variant = e.get("bridge_texts", [])
		if bt_v is Array:
			want_set.append_array(bt_v)
		var rt_v: Variant = e.get("restored_texts", [])
		if rt_v is Array:
			want_set.append_array(rt_v)
		_check(_sorted_copy(texts) == _sorted_copy(want_set),
			"%s partition: assembled lines == bridge lines + restored lines" % key)
		var choice_count: int = 0
		var marker_count: int = 0
		for line_v in assembled:
			if _is_branch_end(line_v):
				marker_count += 1
				var m: Dictionary = line_v
				_check(String(m.get("text", "")) == "",
					"%s branch_end marker carries no text" % key)
				var g: int = int(m.get("goto_index", -1))
				_check(g >= 0 and g <= assembled.size(),
					"%s branch_end goto %d lands inside the entry" % [key, g])
			elif line_v is Dictionary:
				var d: Dictionary = line_v
				var ch_v: Variant = d.get("choices", [])
				if ch_v is Array and (ch_v as Array).size() == 2:
					choice_count += 1
		_check(choice_count == _choices_of(key).size(),
			"%s carries exactly one choice entry per choice point" % key)
		_check(marker_count == _choices_of(key).size(),
			"%s carries exactly one branch_end marker per choice point" % key)


func test_block_structure() -> void:
	for key_v in _keys:
		var key: String = key_v
		var parts: Array = _split_key(key)
		var choices: Array = _choices_of(key)
		for ci in range(choices.size()):
			var c_v: Variant = choices[ci]
			if not (c_v is Dictionary):
				_check(false, "%s choice %d fixture missing" % [key, ci])
				continue
			var c: Dictionary = c_v
			var block: Array = _assembler.assemble_block(
				parts[0], parts[1], ci)
			_check(block.size() == int(c.get("block_len", -1)),
				"%s choice %d block length %d matches the replication"
				% [key, ci, block.size()])
			if block.is_empty():
				continue
			var be: int = int(c.get("branch_end_offset", -1))
			_check(be >= 0 and be < block.size()
				and _is_branch_end(block[be]),
				"%s choice %d branch_end marker at offset %d" % [key, ci, be])
			if be >= 0 and be < block.size() and _is_branch_end(block[be]):
				var m: Dictionary = block[be]
				_check(int(m.get("goto_index", -1))
					== int(c.get("branch_goto_offset", -2)),
					"%s choice %d marker goto matches the replication"
					% [key, ci])
			var markers: int = 0
			for line_v in block:
				if _is_branch_end(line_v):
					markers += 1
			_check(markers == 1,
				"%s choice %d block holds exactly one marker" % [key, ci])
			var prompt_v: Variant = block[0]
			_check(prompt_v is Dictionary,
				"%s choice %d block opens with the prompt entry" % [key, ci])
			if prompt_v is Dictionary:
				var prompt: Dictionary = prompt_v
				var ch_v: Variant = prompt.get("choices", [])
				if ch_v is Array and (ch_v as Array).size() == 2:
					var ch: Array = ch_v
					var c0: Dictionary = ch[0]
					var c1: Dictionary = ch[1]
					_check(int(c0.get("target_index", -999))
						== int(c.get("yes_target", -999)),
						"%s choice %d Yes target matches the replication"
						% [key, ci])
					_check(int(c1.get("target_index", -999))
						== int(c.get("no_target", -999)),
						"%s choice %d No target matches the replication"
						% [key, ci])
			# Section contents, in layout order: NO lines sit
			# between the prompt and the marker; YES lines between
			# the marker and the goto; tail lines from the goto.
			var no_texts_v: Variant = c.get("no_texts", [])
			var yes_texts_v: Variant = c.get("yes_texts", [])
			var tail_texts_v: Variant = c.get("tail_texts", [])
			if be >= 1 and no_texts_v is Array:
				_check(_texts_of(block.slice(1, be)) == no_texts_v,
					"%s choice %d NO section precedes the marker" % [key, ci])
			var goto_off: int = int(c.get("branch_goto_offset", -1))
			if goto_off > be and yes_texts_v is Array:
				_check(_texts_of(block.slice(be + 1, goto_off)) == yes_texts_v,
					"%s choice %d YES section sits between marker and rejoin"
					% [key, ci])
			if goto_off >= 0 and goto_off <= block.size() \
					and tail_texts_v is Array:
				_check(_texts_of(block.slice(goto_off)) == tail_texts_v,
					"%s choice %d tail starts at the marker's goto"
					% [key, ci])


func test_yes_paths_exact() -> void:
	for key_v in _keys:
		var key: String = key_v
		var parts: Array = _split_key(key)
		var choices: Array = _choices_of(key)
		for ci in range(choices.size()):
			var block: Array = _assembler.assemble_block(
				parts[0], parts[1], ci)
			_check(not block.is_empty(), "%s choice %d assembles" % [key, ci])
			var played: Array = _play_block(block, 0)
			var c_v: Variant = choices[ci]
			var want_v: Variant = []
			if c_v is Dictionary:
				var c: Dictionary = c_v
				want_v = c.get("yes_played", [])
			_check(played == want_v,
				"%s choice %d YES path exact: got %s want %s"
				% [key, ci, played, want_v])


func test_no_paths() -> void:
	for key_v in _keys:
		var key: String = key_v
		var parts: Array = _split_key(key)
		var choices: Array = _choices_of(key)
		for ci in range(choices.size()):
			var block: Array = _assembler.assemble_block(
				parts[0], parts[1], ci)
			var played: Array = _play_block(block, 1)
			var c_v: Variant = choices[ci]
			if not (c_v is Dictionary):
				_check(false, "%s choice %d fixture missing" % [key, ci])
				continue
			var c: Dictionary = c_v
			var want_played_v: Variant = c.get("no_played", [])
			_check(played == want_played_v,
				"%s choice %d NO playback matches the replicated v2 semantics"
				% [key, ci])
			var no_texts_v: Variant = c.get("no_texts", [])
			var prefix: Array = [String(c.get("prompt_text", ""))]
			if no_texts_v is Array:
				prefix.append_array(no_texts_v)
			_check(played.slice(0, prefix.size()) == prefix,
				"%s choice %d NO path begins with the exact source NO sequence"
				% [key, ci])
			# Upgraded assertion (v1 could make this at only 6 of
			# 30 points): the NO path is the exact source sequence
			# — own lines, then the shared tail, never YES lines.
			_check(bool(c.get("no_exact", false)),
				"%s choice %d fixture marks the NO path exact" % [key, ci])
			var src_v: Variant = c.get("no_source_sequence", [])
			_check(played == src_v,
				"%s choice %d NO path exact: got %s want %s"
				% [key, ci, played, src_v])


func test_no_split_fallback() -> void:
	_check(not _assembler.has_split("PalletTown", "TEXT_PALLETTOWN_GIRL"),
		"non-choice Kanto ref has no split")
	_check(_assembler.assemble("PalletTown", "TEXT_PALLETTOWN_GIRL").is_empty(),
		"assemble() is empty for a non-split ref (caller keeps the linear bridge)")
	_check(not _assembler.has_split("AzaleaTown", "AzaleaTownSign"),
		"Johto ref has no split (Johto is out of scope this pass)")
	_check(_assembler.assemble_block("BillsHouse",
		"TEXT_BILLSHOUSE_BILL_POKEMON", 7).is_empty(),
		"out-of-range choice ordinal assembles nothing")


func test_choice_block_descriptors() -> void:
	var blocks: Array = _assembler.choice_blocks(
		"Daycare", "TEXT_DAYCARE_GENTLEMAN")
	_check(blocks.size() == 2, "Daycare exposes 2 choice blocks, got %d"
		% blocks.size())
	var assembled: Array = _assembler.assemble(
		"Daycare", "TEXT_DAYCARE_GENTLEMAN")
	for b_v in blocks:
		var b: Dictionary = b_v
		var pi: int = int(b.get("prompt_index", -1))
		_check(pi >= 0 and pi < assembled.size(),
			"descriptor prompt index inside the assembled entry")
		if pi >= 0 and pi < assembled.size():
			var line_v: Variant = assembled[pi]
			_check(line_v is Dictionary,
				"assembled line at the prompt index is a choice entry")
			if line_v is Dictionary:
				var line: Dictionary = line_v
				var ch_v: Variant = line.get("choices", [])
				if ch_v is Array and (ch_v as Array).size() == 2:
					var ch: Array = ch_v
					var c0: Dictionary = ch[0]
					var c1: Dictionary = ch[1]
					_check(int(c0.get("target_index", -999))
						== int(b.get("yes_target", -999)),
						"descriptor Yes target matches the embedded choice entry")
					_check(int(c1.get("target_index", -999))
						== int(b.get("no_target", -999)),
						"descriptor No target matches the embedded choice entry")
					_check(String(c0.get("label", "")) == "Yes"
						and String(c1.get("label", "")) == "No",
						"choice labels are Yes/No in menu order")
		var be: int = int(b.get("branch_end_index", -1))
		_check(be > pi and be < int(b.get("block_end", -1)),
			"descriptor branch_end sits between prompt and block end")
		if be >= 0 and be < assembled.size():
			_check(_is_branch_end(assembled[be]),
				"assembled entry at branch_end_index is the marker")
			if _is_branch_end(assembled[be]):
				var m: Dictionary = assembled[be]
				_check(int(m.get("goto_index", -1))
					== int(b.get("branch_goto", -2)),
					"descriptor branch_goto matches the embedded marker")
		# Daycare's blocks have no tail: the marker's goto is the
		# block end, so the NO path continues past the block.
		_check(int(b.get("branch_goto", -1)) == int(b.get("block_end", -2)),
			"no-tail block: marker goto is the block end")


func test_bill_box_renders_choices() -> void:
	var box_script: GDScript = load("res://systems/dialogue/dialogue_box.gd")
	var box: CanvasLayer = box_script.new()
	get_root().add_child(box)
	var lines: Array = _assembler.assemble(
		"BillsHouse", "TEXT_BILLSHOUSE_BILL_POKEMON")
	_check(lines.size() == 4,
		"Bill entry assembles to 4 entries (3 lines + branch_end marker), got %d"
		% lines.size())
	_check(_playable_texts_of(lines).size() == 3,
		"Bill entry still carries exactly its 3 dialogue lines")
	_check(lines.size() == 4 and _is_branch_end(lines[2]),
		"Bill's marker sits between the NO line and the shared tail")
	box.start_dialogue(lines)
	_check(box.is_showing(), "box shows Bill's dialogue")
	_check(box.choice_count() == 2, "box renders Bill's Yes/No choices")
	var e: Dictionary = _entry("BillsHouse|TEXT_BILLSHOUSE_BILL_POKEMON")
	var choices: Array = _choices_of("BillsHouse|TEXT_BILLSHOUSE_BILL_POKEMON")
	var c0: Dictionary = choices[0]
	var no_texts: Array = c0.get("no_texts", [])
	var tail_texts: Array = c0.get("tail_texts", [])
	box.choose(1)  # No
	_check(box.current_line_text() == String(no_texts[0]),
		"box No path lands on the refusal line")
	box.advance()  # complete the reveal
	box.advance()  # move on: crosses the marker, lands on the tail
	_check(box.current_line_text() == String(tail_texts[0]),
		"box No path rejoins the shared tail")
	box.advance()  # complete the reveal
	box.advance()  # finish
	_check(not box.is_showing() and box.finished_emitted,
		"box finishes after the tail")
	box.queue_free()
